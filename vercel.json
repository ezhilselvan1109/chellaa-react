{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "vite"
    },
    "playground": {
      "root": "apps/playground",
      "framework": "vite"
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "vite",
      "outputDirectory": "storybook-static",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/playground/(.*)",
      "destination": {
        "service": "playground"
      }
    },
    {
      "source": "/playground",
      "destination": {
        "service": "playground"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/storybook",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "docs"
      }
    }
  ]
}

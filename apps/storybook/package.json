{
  "name": "@chellaa/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated component development and visual validation environment for Chellaa React",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "prebuild": "pnpm --filter @chellaa/react build",
    "build": "storybook build -o dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \".storybook/**/*.{ts,tsx}\"",
    "test": "node validate-computed-styles.mjs"
  },
  "dependencies": {
    "@chellaa/react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-interactions": "^8.3.5",
    "@storybook/addon-links": "^8.3.5",
    "@storybook/react": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "storybook": "^8.3.5",
    "vite": "^5.4.8"
  }
}

{
  "name": "chellaa-react-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Chella UI - Production-quality React design system and component library",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "dev:docs": "npm run dev --workspace=@chella-ui/docs",
    "dev:playground": "npm run dev --workspace=@chella-ui/playground"
  },
  "dependencies": {
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT"
}
